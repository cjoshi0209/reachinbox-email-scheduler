# ---------- Core ----------
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
# Public URL of this API (used to build OAuth redirect URIs)
API_URL=http://localhost:4000
# Where the dashboard lives (CORS origin + post-login redirect)
FRONTEND_URL=http://localhost:3000

# ---------- Infrastructure (matches docker-compose.yml) ----------
DATABASE_URL=postgresql://reachinbox:reachinbox@localhost:5432/reachinbox?schema=public
REDIS_URL=redis://localhost:6379
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX=emails

# ---------- Secrets (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))") ----------
# Signs the session cookie + OAuth state tokens (min 32 chars)
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# 32 bytes, base64. Encrypts SMTP passwords and Slack tokens at rest.
ENCRYPTION_KEY=

# ---------- Google OAuth (https://console.cloud.google.com/apis/credentials) ----------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match an "Authorized redirect URI" in the Google console
GOOGLE_REDIRECT_URI=http://localhost:4000/auth/google/callback

# ---------- Slack OAuth (https://api.slack.com/apps) ----------
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
# Must match a Redirect URL in the Slack app. Slack requires HTTPS, so use a tunnel
# (e.g. `cloudflared tunnel --url http://localhost:4000`) and put the https URL here.
SLACK_REDIRECT_URI=http://localhost:4000/auth/slack/callback

# ---------- Scheduler / throughput ----------
# Parallel jobs per worker process
WORKER_CONCURRENCY=5
# Minimum gap between two sends from the same sender, across all workers (ms)
MIN_EMAIL_DELAY_MS=2000
# Hard ceiling of emails per sender per clock hour. A campaign's own "hourly limit"
# can only lower this, never raise it.
MAX_EMAILS_PER_HOUR=200
# Delivery attempts for transient SMTP failures (exponential backoff)
EMAIL_MAX_ATTEMPTS=3
EMAIL_BACKOFF_MS=5000
# A row stuck in "processing" longer than this after a crash is marked failed
# (delivery state unknown -> never auto-resent, to avoid duplicates)
STALE_PROCESSING_MS=300000

# ---------- Bull Board (/admin/queues) ----------
# Access is allowed for any logged-in dashboard user. Optionally also allow HTTP Basic auth:
BULL_BOARD_USER=
BULL_BOARD_PASSWORD=
